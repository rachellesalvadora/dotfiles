#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STAMP="$(date +%Y%m%d%H%M%S)"

confirm_overwrite() {
  local source="$1"
  local target="$2"

  if [ ! -e "$target" ] || [ -L "$target" ]; then
    return 0
  fi

  local source_lines target_lines
  source_lines="$(wc -l < "$source" 2>/dev/null || echo 0)"
  target_lines="$(wc -l < "$target" 2>/dev/null || echo 0)"

  if [ "$target_lines" -gt "$((source_lines * 2))" ] && [ "$target_lines" -gt 20 ]; then
    printf 'Warning: %s has %d lines but the replacement has %d lines.\n' \
      "$target" "$target_lines" "$source_lines" >&2
    printf 'The existing file will be backed up to %s.backup.%s\n' "$target" "$STAMP" >&2
    printf 'Replace it? [y/N] '
    read -r answer
    case "$answer" in
      [yY]*) return 0 ;;
      *) printf 'Skipped %s\n' "$target"; return 1 ;;
    esac
  fi
}

backup_and_link() {
  local source="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if ! confirm_overwrite "$source" "$target"; then
    return 0
  fi

  if [ -L "$target" ]; then
    rm "$target"
  elif [ -e "$target" ]; then
    mv "$target" "$target.backup.$STAMP"
  fi

  ln -s "$source" "$target"
}

if command -v brew >/dev/null 2>&1; then
  brew bundle --file="$ROOT/Brewfile"
else
  echo "Homebrew is not installed. Install it, then re-run script/setup." >&2
fi

backup_and_link "$ROOT/shell/.zshrc" "$HOME/.zshrc"
backup_and_link "$ROOT/shell/aliases.zsh" "$HOME/.aliases.zsh"
backup_and_link "$ROOT/git/.gitconfig" "$HOME/.gitconfig"

mkdir -p "$HOME/.claude"
backup_and_link "$ROOT/claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"

echo "Dotfiles installed."
